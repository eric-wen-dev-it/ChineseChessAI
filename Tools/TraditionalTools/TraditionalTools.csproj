<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\ChineseChessAI.csproj" />
  </ItemGroup>

  <!-- Reference CUDA libtorch directly so its native DLLs (~5GB, reassembled
       from split packages) copy into this exe's output for GPU inference. -->
  <ItemGroup>
    <PackageReference Include="TorchSharp-cuda-windows" Version="0.105.2" />
  </ItemGroup>

</Project>
